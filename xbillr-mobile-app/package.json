{
  "name": "xbillr-mobile",
  "version": "1.0.0",
  "description": "XBillr Mobile App – Zugriff auf xbillr.eu für Android und iOS",
  "capabilities": {
    "android": true,
    "ios": true
  },
  "capacitor": {
    "platforms": ["android", "ios"]
  },
  "scripts": {
    "build": "echo 'No build step – static www'",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "android": "npx cap run android",
    "ios": "npx cap run ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.1",
    "@capacitor/keyboard": "^6.0.1",
    "@capacitor/status-bar": "^6.0.1"
  }
}
