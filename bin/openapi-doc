#!/bin/bash
# openapi-doc
# API documentation generation with OpenAPI Generator
# Simple, reliable script without progress bar issues
# Usage: openapi-doc [OPTIONS]

PROG=$(basename "$0")
DIR=$(dirname "$0")
BASEDIR="${DIR}/.."
echo $BASEDIR

# Default values
API_FILE="${BASEDIR}/backend/openapi.yaml"
OUTPUT_DIR="${BASEDIR}/documentation/api"
GENERATOR="html2"
TEMPLATE_DIR=""
CUSTOM_CSS=""
CUSTOM_JS=""
THEME="light"
VALIDATE_ONLY=false
CLEAN_OUTPUT=false
SHOW_HELP=false
VERBOSE=false
QUIET=false

# Help function
show_help() {
    cat << EOF
OpenAPI Generator for API documentation.

Usage: $PROG [OPTIONS]

Options:
  -a, --api FILE       OpenAPI YAML/JSON file (Default: $API_FILE)
  -o, --out DIR        Output directory (Default: $OUTPUT_DIR)
  -g, --generator GEN  Generator type (Default: $GENERATOR)
                       Available: html, html2, dynamic-html
  --template DIR       Custom template directory
  -c, --css FILE       Custom CSS file
  -j, --js FILE        Custom JavaScript file
  -t, --theme NAME     Theme for html2 generator (Default: $THEME)
                       For html2: light, dark
  --validate           Only validate API, don't generate documentation
  --clean              Clean output directory before generation
  -v, --verbose        Verbose output
  -q, --quiet          Quiet mode - minimal output
  -h, --help           Show this help message

Examples:
  $PROG
  $PROG --api api.yaml --out ./docs -t dark
  $PROG -a openapi.json -o ./public -g html2
  $PROG --api spec.yaml --validate
  $PROG --api api.yaml --clean -t dark
  $PROG --api api.yaml -q  # Quiet mode
EOF
}

# Output functions
echo_info() {
    if [ "$QUIET" = false ]; then
        echo "ℹ️  $*"
    fi
}

echo_success() {
    if [ "$QUIET" = false ]; then
        echo "✅ $*"
    fi
}

echo_warning() {
    if [ "$QUIET" = false ]; then
        echo "⚠️  $*"
    fi
}

echo_error() {
    echo "❌ $*" >&2
}

# Parameter parsing
while [[ $# -gt 0 ]]; do
    case $1 in
        -a|--api)
            API_FILE="$2"
            shift 2
            ;;
        -o|--out|--output)
            OUTPUT_DIR="$2"
            shift 2
            ;;
        -g|--generator)
            GENERATOR="$2"
            shift 2
            ;;
        --template)
            TEMPLATE_DIR="$2"
            shift 2
            ;;
        -c|--css)
            CUSTOM_CSS="$2"
            shift 2
            ;;
        -j|--js)
            CUSTOM_JS="$2"
            shift 2
            ;;
        -t|--theme)
            THEME="$2"
            shift 2
            ;;
        --validate)
            VALIDATE_ONLY=true
            shift
            ;;
        --clean)
            CLEAN_OUTPUT=true
            shift
            ;;
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        -q|--quiet)
            QUIET=true
            shift
            ;;
        -h|--help)
            SHOW_HELP=true
            shift
            ;;
        *)
            echo_error "Unknown parameter: $1"
            echo "Use -h for help"
            exit 1
            ;;
    esac
done

# Show help
if [ "$SHOW_HELP" = true ]; then
    show_help
    exit 0
fi

# Check if npx is available
check_npx() {
    if ! command -v npx &> /dev/null; then
        echo_error "npx is not installed. Please install Node.js."
        exit 1
    fi
}

# Check API file
check_api_file() {
    if [ ! -f "$API_FILE" ]; then
        echo_error "API file not found: $API_FILE"
        exit 1
    fi
    
    if [ ! -s "$API_FILE" ]; then
        echo_error "API file is empty: $API_FILE"
        exit 1
    fi
}

# Validate generator
validate_generator() {
    case "$GENERATOR" in
        html|html2|dynamic-html)
            # Valid generator
            ;;
        *)
            echo_warning "Unknown generator: $GENERATOR. Using 'html2' instead."
            GENERATOR="html2"
            ;;
    esac
}

# Validate theme
validate_theme() {
    if [ "$GENERATOR" != "html2" ] && [ "$THEME" != "light" ]; then
        echo_warning "Theme is only supported for html2 generator. Using 'light'."
        THEME="light"
    fi
    
    if [ "$GENERATOR" = "html2" ]; then
        case "$THEME" in
            light|dark)
                # Valid theme
                ;;
            *)
                echo_warning "Unknown theme: $THEME. Using 'light'."
                THEME="light"
                ;;
        esac
    fi
}

# Validate API
validate_api() {
    echo_info "Validating API specification..."
    
    # Use timeout to prevent hanging
    timeout 30s npx @openapitools/openapi-generator-cli validate -i "$API_FILE" 2>&1
    
    if [ $? -eq 0 ]; then
        echo_success "API specification is valid"
        return 0
    elif [ $? -eq 124 ]; then
        echo_warning "Validation timed out after 30 seconds"
        echo_info "Skipping validation..."
        return 0
    else
        echo_error "API specification is invalid"
        return 1
    fi
}

# Build generation command
build_generation_command() {
    local cmd="npx @openapitools/openapi-generator-cli generate"
    cmd="$cmd -i \"$API_FILE\""
    cmd="$cmd -g \"$GENERATOR\""
    cmd="$cmd -o \"$OUTPUT_DIR\""
    
    # Add template if specified
    if [ -n "$TEMPLATE_DIR" ] && [ -d "$TEMPLATE_DIR" ]; then
        cmd="$cmd --template \"$TEMPLATE_DIR\""
    fi
    
    # Build additional properties
    local props=""
    if [ "$GENERATOR" = "html2" ]; then
        props="theme=$THEME"
        props="$props,hideGenerationTimestamp=true"
        
        if [ -n "$CUSTOM_CSS" ] && [ -f "$CUSTOM_CSS" ]; then
            cp "$CUSTOM_CSS" "$OUTPUT_DIR/custom.css" 2>/dev/null
            props="$props,customCss=custom.css"
        fi
        
        if [ -n "$CUSTOM_JS" ] && [ -f "$CUSTOM_JS" ]; then
            cp "$CUSTOM_JS" "$OUTPUT_DIR/custom.js" 2>/dev/null
            props="$props,customJs=custom.js"
        fi
    elif [ "$GENERATOR" = "html" ]; then
        props="appName=APIDocs"
        props="$props,appDescription=API+Documentation"
    fi
    
    if [ -n "$props" ]; then
        cmd="$cmd --additional-properties \"$props\""
    fi
    
    echo "$cmd"
}

# Generate documentation
generate_documentation() {
    local start_time=$(date +%s)
    
    # Prepare output directory
    if [ "$CLEAN_OUTPUT" = true ]; then
        rm -rf "$OUTPUT_DIR"
    fi
    mkdir -p "$OUTPUT_DIR"
    
    # Build and execute command
    local cmd=$(build_generation_command)
    
    if [ "$VERBOSE" = true ] && [ "$QUIET" = false ]; then
        echo_info "Command: $cmd"
    fi
    
    echo_info "Generating documentation..."
    
    if [ "$QUIET" = true ]; then
        eval "$cmd" >/dev/null 2>&1
    else
        eval "$cmd"
    fi
    
    local exit_code=$?
    local end_time=$(date +%s)
    local duration=$((end_time - start_time))
    
    if [ $exit_code -eq 0 ]; then
        echo_success "Documentation generated in ${duration}s"
        
        # Find the main HTML file
        local main_html=$(find "$OUTPUT_DIR" -maxdepth 2 -name "index.html" -type f 2>/dev/null | head -1)
        if [ -z "$main_html" ]; then
            main_html=$(find "$OUTPUT_DIR" -name "*.html" -type f 2>/dev/null | head -1)
        fi
        
        if [ -n "$main_html" ]; then
            if [ "$QUIET" = false ]; then
                echo_info "Main file: $main_html"
                echo_info "Open with: file://$(realpath "$main_html" 2>/dev/null || echo "$main_html")"
            else
                # Quiet mode: output only the file path
                echo "$main_html"
            fi
        fi
        
        return 0
    else
        echo_error "Failed to generate documentation (took ${duration}s)"
        return 1
    fi
}

# Main function - SIMPLE AND RELIABLE
main() {
    if [ "$QUIET" = false ]; then
        echo ""
        echo "🔧 OpenAPI Documentation Generator"
        echo "=================================="
        echo ""
    fi
    
    # Step 1: Check npx
    echo_info "Checking system..."
    check_npx
    
    # Step 2: Check API file
    check_api_file
    
    # Step 3: Validate generator and theme
    validate_generator
    validate_theme
    
    # Step 4: Show configuration
    if [ "$QUIET" = false ]; then
        echo_info "Configuration:"
        echo "  API file:   $API_FILE"
        echo "  Output:     $OUTPUT_DIR"
        echo "  Generator:  $GENERATOR"
        echo "  Theme:      $THEME"
        [ -n "$TEMPLATE_DIR" ] && echo "  Template:   $TEMPLATE_DIR"
        echo ""
    fi
    
    # Step 5: Validate if requested
    if [ "$VALIDATE_ONLY" = true ]; then
        validate_api
        exit $?
    fi
    
    # Step 6: Optional validation
    if [ "$QUIET" = false ]; then
        read -p "Validate API before generation? (y/N): " -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            if ! validate_api; then
                read -p "Validation failed. Generate anyway? (y/N): " -n 1 -r
                echo
                if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                    exit 1
                fi
            fi
        fi
    fi
    
    # Step 7: Generate
    if ! generate_documentation; then
        echo_error "Generation failed"
        echo_info "Troubleshooting:"
        echo_info "1. Try validating first: $PROG --api \"$API_FILE\" --validate"
        echo_info "2. Try simpler generator: $PROG --api \"$API_FILE\" -g html"
        echo_info "3. Check OpenAPI Generator: npx @openapitools/openapi-generator-cli version"
        exit 1
    fi
    
    # Step 8: Success
    if [ "$QUIET" = false ]; then
        echo ""
        echo_success "All done! 🎉"
    fi
}

# Error handling
trap 'echo ""; echo_error "Interrupted"; exit 1' INT

# Execute
main "$@"
